# Django
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_ALEATORIA_UNICA
DJANGO_DEBUG=1

# Cifrado de credenciales de pago. Clave SOLO para desarrollo; en producción generar una propia:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PAYMENT_CREDENTIALS_KEY=REEMPLAZAR_CON_CLAVE_FERNET_GENERADA

# PostgreSQL
POSTGRES_DB=ecommerce_db
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=REEMPLAZAR_CON_PASSWORD_POSTGRES
POSTGRES_PORT=5432

# MongoDB
MONGO_USER=admin_mongo
MONGO_PASSWORD=REEMPLAZAR_CON_PASSWORD_MONGO
MONGO_DB_NAME=consultoria_nosql
VITE_API_URL=http://localhost:8000

# Frontend
GOOGLE_CLIENT_ID=76664192595-etnqg80mscvv62p1c42a0f2gndcqpmrh.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=76664192595-etnqg80mscvv62p1c42a0f2gndcqpmrh.apps.googleusercontent.com
# Retiro en tienda: búsqueda de direcciones solo desde el backend (opcional).
PICKUP_GEOCODING_PROVIDER=
PICKUP_GOOGLE_GEOCODING_KEY=

# Correo transaccional (SCRUM-423). Sin configurar, los correos se imprimen en el log del backend.
# Para verlos en el navegador con Mailpit: dejar estas 4 lineas sin comentar,
# ejecutar `docker compose --profile correo up -d mailpit` y abrir http://localhost:8025
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mailpit
# EMAIL_PORT=1025
# EMAIL_USE_TLS=0
# Envio real: EMAIL_BACKEND smtp + el servidor de tu proveedor (ejemplo Gmail con contraseña de aplicacion):
# EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USE_TLS=1  EMAIL_HOST_USER=tu@correo  EMAIL_HOST_PASSWORD=clave
# Nombre y direccion que ve el comprador como remitente (la tienda pone su nombre):
DEFAULT_FROM_EMAIL=
# Direccion publica de la tienda: base de los enlaces de los correos (seguimiento del pedido).
# En produccion, por ejemplo https://mitienda.cl/plantilla/1 (sin barra al final).
STOREFRONT_PUBLIC_URL=

# Seguridad (usar valores reales en .env; local de desarrollo abajo)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# En despliegue TLS con proxy HTTPS correctamente configurado; en local no activar redirección.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
